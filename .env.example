# Copy this file to .env and fill in real values. .env is never committed.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (for real Forgot Password sending) ---
# Fastest free option: a Gmail account with an "App Password" (not your
# normal Gmail password — Google Account > Security > 2-Step Verification
# > App passwords). Free tier is fine at your project's scale.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com

# If EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are left blank, emails print to
# the console instead of sending for real — useful while developing.
