# Copy this file to .env and fill in real values. .env is never committed.

# Required: any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (SMTP) ---
# Used for invitation, password-setup and password-reset emails.
# For Gmail use an App Password (Google Account > Security > App passwords),
# not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# --- OpenAI (AI draft generation) ---
# Required: the application will not start while this is empty. The value
# below is only a placeholder; replace it with your own key to generate
# drafts. Never commit the real key.
OPENAI_API_KEY=your-openai-api-key
