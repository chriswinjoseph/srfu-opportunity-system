# Copy this file to .env and fill in real values. .env is never committed.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (Elastic Email API — see accounts/views.py) ---
# Sending is done via a direct HTTPS call to the Elastic Email API, not SMTP.
# DEFAULT_FROM_EMAIL must be an address verified in Elastic Email.
ELASTIC_EMAIL_API_KEY=your-elastic-email-api-key
DEFAULT_FROM_EMAIL=your-verified-sender@example.com